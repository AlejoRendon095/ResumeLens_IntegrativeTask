CandidateModel:
  'candidate' name=STRING '{'
    (contact=ContactBlock)?
    education*=EducationBlock
    experience*=ExperienceBlock
    (skills=SkillsBlock)?
    classification=ClassificationBlock
  '}'
;

ContactBlock:
  'contact' '{'
    (
      ('email' emails+=STRING) |
      ('phone' phones+=STRING) |
      ('link' links+=STRING)
    )*
  '}'
;

EducationBlock:
  'education' '{'
    ('degree' degree=STRING)?
    ('institution' institution=STRING)?
    ('year' year=STRING)?
  '}'
;

ExperienceBlock:
  'experience' '{'
    ('years' years=NUMBER)?
    ('description' description=STRING)?
  '}'
;

SkillsBlock:
  'skills' '{'
    skills*=SkillToken
  '}'
;

SkillToken:
  /[A-Z][A-Z_]*/
;

ClassificationBlock:
  'classification' '{'
    entries+=ProfileClassification
  '}'
;

ProfileClassification:
  profile_id=ProfileId ':' verdict=Verdict
;

ProfileId:
  /[A-Z][A-Z_]*/
;

Verdict:
  'ACCEPTED' | 'REJECTED'
;
