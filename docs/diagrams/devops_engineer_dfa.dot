    "D1" -> "D1" [label="LINUX"];
    "D1" -> "D2" [label="GIT"];
    "D2" -> "D2" [label="GIT"];
    "D2" -> "D3" [label="CI_CD"];
    "D3" -> "D3" [label="CI_CD"];
