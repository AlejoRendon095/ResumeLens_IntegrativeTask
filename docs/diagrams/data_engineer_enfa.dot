digraph automaton {
    rankdir=LR;
    node [shape=circle, fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=10];
    labelloc="t"; label="DATA_ENGINEER - ε-NFA";
    start [shape=point, width=0.15, label=""];
    "q0" [shape=circle];
    "p0" [shape=circle];
    "q1" [shape=circle];
    "p1" [shape=circle];
    "q2" [shape=circle];
    "p2" [shape=circle];
    "q3" [shape=circle];
    "q4" [shape=circle];
    "p3" [shape=circle];
    "q5" [shape=circle];
    "p4" [shape=circle];
    "p5" [shape=circle];
    "q6" [shape=doublecircle];
    start -> "q0";
    "q0" -> "p0" [label="PYTHON"];
    "p0" -> "p0" [label="PYTHON"];
    "p0" -> "q1" [label="ε"];
    "q1" -> "p1" [label="SQL\nPOSTGRESQL\nMYSQL"];
    "p1" -> "p1" [label="SQL\nPOSTGRESQL\nMYSQL"];
    "p1" -> "q2" [label="ε"];
    "q2" -> "p2" [label="SPARK"];
    "p2" -> "p2" [label="SPARK"];
    "p2" -> "q3" [label="ε"];
    "q3" -> "p3" [label="AIRFLOW"];
    "q3" -> "q4" [label="ε"];
    "q4" -> "p4" [label="KAFKA"];
    "q4" -> "q5" [label="ε"];
    "p3" -> "p3" [label="AIRFLOW"];
    "p3" -> "q4" [label="ε"];
    "q5" -> "p5" [label="GIT"];
    "p4" -> "p4" [label="KAFKA"];
    "p4" -> "q5" [label="ε"];
    "p5" -> "p5" [label="GIT"];
    "p5" -> "q6" [label="ε"];
}
